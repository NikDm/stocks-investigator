{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stocks-investigator",
  "account_id": "00000000000000000000000000000000",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "research.example.com", "custom_domain": true }],
  "limits": { "cpu_ms": 20000 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "stocks-investigator",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "APP_ORIGIN": "https://research.example.com",
    "ACCESS_ISSUER": "https://configure-your-team.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "configure-before-use",
    "JOBS_ENABLED": "false"
  },
  "observability": { "enabled": false }
}
